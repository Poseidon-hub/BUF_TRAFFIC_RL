<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="kaliningrad.net.xml"/>
        <route-files value="kaliningrad.vtypes.xml,autogenerated_diagnostic_demand.rou.xml,autogenerated_pedestrians.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="60"/>
        <step-length value="1"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <duration-log.disable value="true"/>
    </report>
    <traci_server>
        <quit-on-end value="true"/>
    </traci_server>
</configuration>
