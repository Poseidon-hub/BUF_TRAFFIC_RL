<?xml version="1.0" encoding="UTF-8"?>
<!--
    Vehicle type definitions for the Kaliningrad mixed-mode simulation.
    Generated by demand_generator.write_vtypes_file()
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ── Passenger car ─────────────────────────────────────────── -->
    <!-- Krauss car-following model with heterogeneous speed factors  -->
    <vType id="car"
           vClass="passenger"
           color="0.8,0.8,0.8"
           length="4.5"
           maxSpeed="16.7"
           accel="2.6"
           decel="4.5"
           sigma="0.5"
           speedFactor="normc(1,0.1,0.2,2)"
           guiShape="passenger"/>

    <!-- ── City bus ──────────────────────────────────────────────── -->
    <!-- Low-floor articulated bus; stops at designated bus stops    -->
    <vType id="bus"
           vClass="bus"
           color="0.2,0.5,0.9"
           length="12.0"
           maxSpeed="13.9"
           accel="1.2"
           decel="4.0"
           sigma="0.2"
           speedFactor="normc(1,0.05,0.8,1.2)"
           guiShape="bus"/>

    <!-- ── Tram ──────────────────────────────────────────────────── -->
    <!-- Articulated tram; restricted to railway=tram edges in OSM  -->
    <vType id="tram"
           vClass="tram"
           color="0.9,0.3,0.1"
           length="28.0"
           maxSpeed="11.1"
           accel="1.0"
           decel="3.5"
           sigma="0.1"
           speedFactor="normc(1,0.02,0.9,1.1)"/>

</routes>
